/* Ресурсы утилиты ZI Office StartFix
 * Собирается компилятором ресурсов:  zig rc  или  windres
 */

1 ICON "app.ico"

/* Манифест: права администратора, визуальные стили, DPI */
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "CompanyName",      "ZI Office"
            VALUE "FileDescription",  "ZI Office StartFix - восстановление кнопки Пуск (Windows 10/11, Server 2012-2025)"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "StartFix"
            VALUE "LegalCopyright",   "ZI Office"
            VALUE "OriginalFilename", "StartFix.exe"
            VALUE "ProductName",      "ZI Office StartFix"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "Автономная утилита: не требует .NET, Visual C++ и UCRT"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
